# Database
POSTGRES_USER=peblo
POSTGRES_PASSWORD=peblo_dev
POSTGRES_DB=peblo_tv
DATABASE_URL=postgresql+asyncpg://peblo:peblo_dev@db:5432/peblo_tv

# Auth
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=480

# Storage
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=/app/storage
# STORAGE_R2_ACCOUNT_ID=
# STORAGE_R2_ACCESS_KEY_ID=
# STORAGE_R2_SECRET_ACCESS_KEY=
# STORAGE_R2_BUCKET=

# API
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Default admin account (seeded)
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin123
DEFAULT_EDITOR_USERNAME=editor
DEFAULT_EDITOR_PASSWORD=editor123
